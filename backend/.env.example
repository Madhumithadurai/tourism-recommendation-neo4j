# Copy this file to .env and set the password you chose in Neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# 127.0.0.1 = only this computer. 0.0.0.0 = others on the same network can open
# http://<this-computer-ip>:5000
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Allow CREATE/MERGE/DELETE/SET in the Cypher playground, and the "Delete all data" button
ALLOW_WRITE_PLAYGROUND=false
ALLOW_RESET=true
